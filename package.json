{
  "name": "fleet",
  "version": "0.1.0",
  "private": true,
  "description": "멀티 LLM 오케스트레이션 데스크톱 앱",
  "author": "Dowon Park",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pdw96/fleet.git"
  },
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.22.1 <23 || >=24"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "electron-updater": "^6.8.9",
    "safe-regex": "^2.1.1"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "brain": "node scripts/brain/build.mjs",
    "brain:watch": "node scripts/brain/watch.mjs",
    "skills:lint": "node scripts/skills-lint.mjs",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/safe-regex": "^1.1.6",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "force-graph": "^1.51.4",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^17.0.8",
    "prettier": "3.8.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^7.3.5",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "*.{json,css,yml,yaml,html}": [
      "prettier --write"
    ],
    ".claude/skills/**/*.md": [
      "node scripts/skills-lint.mjs"
    ],
    ".claude/workflows/**/*.js": [
      "node scripts/skills-lint.mjs"
    ],
    ".github/workflows/*.yml": [
      "node scripts/skills-lint.mjs"
    ]
  },
  "overrides": {
    "form-data": "^4.0.6",
    "vite": {
      "esbuild": "^0.28.1"
    }
  }
}
