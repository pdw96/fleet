# Fleet 웹터미널 (Phase A · #195) 환경 변수.
# 이 파일을 `.env` 로 복사해 채운다.  ⚠️ `.env` 는 시크릿을 담으므로 커밋 금지(.gitignore 확인).

# ─────────────────────────── 터널 (tunnel 프로파일) ───────────────────────────
# Cloudflare Zero Trust 대시보드에서 터널을 만들고 발급되는 토큰.  ⚠️ 시크릿 — 절대 커밋 금지.
# 대시보드 > Networks > Tunnels > (터널) > Public Hostname 에서 Service 를 http://ttyd:7681 로 설정.
# 그리고 Access > Applications 에 그 호스트네임을 Self-hosted 앱으로 추가 + MFA 정책(필수).
TUNNEL_TOKEN=

# cloudflared 이미지 태그 고정 (floating latest 금지).
CLOUDFLARED_VERSION=2026.6.1

# ─────────────────────────────── 웹터미널 ───────────────────────────────
# 두 문이 공유하는 프로젝트 폴더(호스트 바인드). WSL2 파일시스템 경로 권장(윈도 경로 바인드는 느림).
# uid 1000(node)이 쓸 수 있어야 한다.
WORKSPACE_DIR=./workspace

# ttyd basic-auth (선택 · Access 뒤 심층방어). "user:password" 형식. 비우면 미적용.
TTYD_CREDENTIAL=

# ttyd 최대 동시 클라이언트(랩탑+폰 동시 접속 허용). 클라이언트들은 같은 tmux 세션을 미러링한다.
TTYD_MAX_CLIENTS=5

# cross-origin WebSocket 거부(-O). 1=on(기본·권장). CSWSH 방어이지 접근제어가 아니다 —
# ⚠️ 끄면 Access 가 있어도 CSWSH 가 열린다(CF_Authorization 쿠키 기본 SameSite=None → cross-origin WS 자동 첨부).
# 정상 터널은 Host 를 보존해 -O 가 깨지지 않으므로 끌 이유가 거의 없다. 부득이 0 이면 TTYD_CREDENTIAL 동반 필수.
TTYD_CHECK_ORIGIN=1

# ─────────────────── 문② Fleet 오케스트레이션 서버 (fleet 서비스 · #197-B6) ───────────────────
# access 모드 필수 3종(Cloudflare Access JWT 서버 자체 검증). 셋 다 있어야 FLEET_HOST=0.0.0.0 부팅 통과.
#  · TEAM_DOMAIN = Access 팀 도메인(issuer·JWKS base).  · AUD = Access 앱 audience tag(대시보드 앱 상세).
#  · PUBLIC_ORIGIN = 브라우저가 보는 fleet 오리진(Origin exact 대조·nonce 바인딩).
FLEET_ACCESS_TEAM_DOMAIN=
FLEET_ACCESS_AUD=
FLEET_PUBLIC_ORIGIN=

# API 키 디스크 영속용 대칭키(AES-256-GCM env-key). base64 32바이트 권장. ⚠️ 시크릿 — 커밋 금지.
# 미설정 시 API 키는 영속되지 않는다(라이브 세션만 유지 — 구독 CLI 는 cli-auth 볼륨이라 무영향).
FLEET_SECRET_KEY=

# 서버 bind/port. FLEET_HOST=0.0.0.0 은 컨테이너 내부망 도달에 필요(access 완비 시에만 허용).
FLEET_HOST=0.0.0.0
FLEET_PORT=8791

# ─────────────────────────── 이미지 빌드 (버전 고정) ───────────────────────────
# 갱신 절차: 값을 올린다 → 재빌드 → `bash deploy/smoke.sh` GREEN → 교체 (README 「운영」 참조).
NODE_IMAGE=node:24-bookworm-slim
CLAUDE_VERSION=2.1.199
CODEX_VERSION=0.142.5
GEMINI_VERSION=0.49.0
TTYD_VERSION=1.7.7
IMAGE_TAG=local
