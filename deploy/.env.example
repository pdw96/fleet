# Fleet 웹터미널 (Phase A · #195) 환경 변수.
# 이 파일을 `.env` 로 복사해 채운다.  ⚠️ `.env` 는 시크릿을 담으므로 커밋 금지(.gitignore 확인).

# ─────────────────────────── 터널 (tunnel 프로파일) ───────────────────────────
# Cloudflare Zero Trust 대시보드에서 터널을 만들고 발급되는 토큰.  ⚠️ 시크릿 — 절대 커밋 금지.
# 대시보드 > Networks > Tunnels > (터널) > Public Hostname 에서 Service 를 http://ttyd:7681 로 설정.
# 그리고 Access > Applications 에 그 호스트네임을 Self-hosted 앱으로 추가 + MFA 정책(필수).
TUNNEL_TOKEN=

# cloudflared 이미지 태그 고정 (floating latest 금지).
CLOUDFLARED_VERSION=2026.6.1

# ─────────────────────────────── 웹터미널 ───────────────────────────────
# 두 문이 공유하는 프로젝트 폴더(호스트 바인드). WSL2 파일시스템 경로 권장(윈도 경로 바인드는 느림).
# uid 1000(node)이 쓸 수 있어야 한다.
WORKSPACE_DIR=./workspace

# ttyd basic-auth (선택 · Access 뒤 심층방어). "user:password" 형식. 비우면 미적용.
TTYD_CREDENTIAL=

# ttyd 최대 동시 클라이언트(랩탑+폰 동시 접속 허용). 클라이언트들은 같은 tmux 세션을 미러링한다.
TTYD_MAX_CLIENTS=5

# cross-origin WebSocket 거부(-O). 1=on(기본·권장). CSWSH 방어이지 접근제어가 아니다 —
# ⚠️ 끄면 Access 가 있어도 CSWSH 가 열린다(CF_Authorization 쿠키 기본 SameSite=None → cross-origin WS 자동 첨부).
# 정상 터널은 Host 를 보존해 -O 가 깨지지 않으므로 끌 이유가 거의 없다. 부득이 0 이면 TTYD_CREDENTIAL 동반 필수.
TTYD_CHECK_ORIGIN=1

# ─────────────────── 문② Fleet 오케스트레이션 서버 (fleet 서비스 · #197-B6) ───────────────────
# access 모드 필수 3종(Cloudflare Access JWT 서버 자체 검증). 셋 다 있어야 FLEET_HOST=0.0.0.0 부팅 통과.
#  · TEAM_DOMAIN = Access 팀 도메인(issuer·JWKS base).  · AUD = Access 앱 audience tag(대시보드 앱 상세).
#  · PUBLIC_ORIGIN = 브라우저가 보는 fleet 오리진(Origin exact 대조·nonce 바인딩).
FLEET_ACCESS_TEAM_DOMAIN=
FLEET_ACCESS_AUD=
FLEET_PUBLIC_ORIGIN=

# API 키 디스크 영속용 대칭키(AES-256-GCM env-key). base64 32바이트 권장. ⚠️ 시크릿 — 커밋 금지.
# 미설정 시 API 키는 영속되지 않는다(라이브 세션만 유지 — 구독 CLI 는 cli-auth 볼륨이라 무영향).
FLEET_SECRET_KEY=

# 서버 bind/port. FLEET_HOST=0.0.0.0 은 컨테이너 내부망 도달에 필요(access 완비 시에만 허용).
FLEET_HOST=0.0.0.0
FLEET_PORT=8791

# 승인 보류 TTL(#216 C1) — presence=0(외출·접속 클라 0) 승인이 시한부로 보류되는 시간(ms).
#  · 미설정(빈값) = 600000(10분).  · 유효 범위 [5000, 1800000](5초~30분).
#  ⚠️ 범위 밖·비수치 = 부팅 거부(loud fail — docker logs 에서 FLEET_APPROVAL_TTL_MS 메시지 확인).
#  "외출 중 폰 승인"은 응답 여유를 위해 상향 권장(예: 1800000=30분). fail-closed 종착 = 만료 거부·취소 abort.
FLEET_APPROVAL_TTL_MS=600000

# graceful drain 상한(#216 C3) — SIGTERM(재배포/docker stop) 시 진행 런이 완주할 유예(ms)·초과 시 force 종료.
#  · 미설정(빈값) = 25000(25초).  · 유효 범위 [1000, 120000](1초~2분).
#  ⚠️ 범위 밖·비수치 = 부팅 거부(loud fail — docker logs 에서 FLEET_DRAIN_TIMEOUT_MS 메시지 확인).
#  ⚠️ 조율 계약(ADR-0011): FLEET_STOP_GRACE ≥ (FLEET_DRAIN_TIMEOUT_MS/1000 + 3). Docker 는 stop_grace_period
#     만료 시 SIGKILL 로 드레인을 절단하므로, 상한을 올리면 STOP_GRACE 도 함께 올려야 실제로 honor 된다.
FLEET_DRAIN_TIMEOUT_MS=25000

# 컨테이너 종료 유예(docker stop → SIGTERM 후 SIGKILL 까지 · compose fleet stop_grace_period 값).
#  drain 상한보다 커야 한다(위 조율 계약). 기본 30s(=25s drain + 3s teardown + 2s 여유).
FLEET_STOP_GRACE=30s

# CLI 내부 샌드박스 경계(#214 · ADR-0010).  cli | container.
#  · container = codex 를 danger-full-access + --skip-git-repo-check 로 돌려 비특권 컨테이너의 bwrap
#    (user namespace) 실패를 회피(컨테이너 = 유일 샌드박스 경계). compose 가 이 값을 기본으로 준다.
#  · cli = CLI 내부 샌드박스 유지(데스크톱·베어호스트 무회귀 — 코드 기본값도 cli).
#  ⚠️ 기본값 비대칭: 코드 기본 = cli(데스크톱 안전), compose 기본 = container(컨테이너 배포).
#  ⚠️ 그 외 값(오타 등) = 부팅 거부(loud fail) — docker logs 에서 FLEET_SANDBOX_BOUNDARY 메시지 확인.
FLEET_SANDBOX_BOUNDARY=container

# Workbench 킬스위치 (#251) — 작업(task)별 격리 git worktree = «Workbench» 표면.
#  · 0(기본) = 비활성. 현재 서버 표면은 코어를 랜딩하는 중이라 켜도 bench 는 생성·실행되지 않는다.
#  · 1 = 활성(명시 opt-in). 롤백은 코드 revert 가 아니라 이 값을 0 으로 되돌리는 것이다.
#  ⚠️ 그 외 값(true/yes/on/오타) = 부팅 거부(loud fail) — 「켰는데 안 켜짐」을 조용히 겪지 않게 한다.
#  ⚠️ 서버(컨테이너) 표면 전용 — 데스크톱 Electron 은 이 값과 무관하다(#255).
FLEET_WORKBENCH=0

# ─────────────────────────── 이미지 빌드 (버전 고정) ───────────────────────────
# 갱신 절차: 값을 올린다 → 재빌드 → `bash deploy/smoke.sh` GREEN → 교체 (README 「운영」 참조).
NODE_IMAGE=node:24-bookworm-slim
CLAUDE_VERSION=2.1.199
CODEX_VERSION=0.142.5
GEMINI_VERSION=0.49.0
TTYD_VERSION=1.7.7
IMAGE_TAG=local

# ─────────────────── GHCR pull 배포 (docker-compose.ghcr.yml · #222) ───────────────────
# 서버가 GHCR 이미지를 pull 할 때 쓰는 태그. 위 IMAGE_TAG(로컬 빌드용)와 분리 — 서버 .env 에 IMAGE_TAG=local
# 을 그대로 복사해도 GHCR pull 은 이 GHCR_TAG 를 쓰므로 ghcr.io/…:local(부재) 404 를 피한다.
#  · 기본(빈값) = latest.  · 롤백/재현 = sha-<12hex>(발행 워크플로가 커밋별로 찍는 immutable 태그).
#  프로덕션은 GHCR_TAG=sha-<N> 단일 핀 권장 — 두 이미지 동일 커밋 세트 보장(스큐·latest 회귀 방지).
GHCR_TAG=latest
